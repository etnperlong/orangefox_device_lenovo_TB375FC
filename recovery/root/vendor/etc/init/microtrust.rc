# Microtrust (beanpod) TEE host daemon for the recovery. The arguments are
# those of the stock /vendor/etc/init/microtrust.rc; stock also starts it on
# "fs", before /data exists. The isee-ffa.ko driver it talks to is loaded from
# vendor_ramdisk00. The daemon sets vendor.soter.teei.init=INIT_OK once the
# TEE is up, which starts KeyMint and Gatekeeper.
#
# Like the decryption services of the official OrangeFox trees it runs as root
# in the recovery domain. It starts on "fs", before the recovery mounts any of
# the ROM's partitions, so /vendor still is the ramdisk copy then.

service teei_daemon /vendor/bin/teei_daemon \
    -r 020b0000000000000000000000000000 \
    -r 020f0000000000000000000000000000 \
    -r 06090000000000000000000000000000 \
    -r 05120000000000000000000000000000 \
    -r 40188311faf343488db888ad39496f9a \
    -r 07060000000000000000000000007169 \
    -r 4be4f7dc1f2c11e5b5f7727283247c7f \
    -r 9073f03a9618383bb1856eb3f990babd \
    -r 08050000000000000000000000003419 \
    -r 5020170115e016302017012521300000 \
    -r 0f5eed3c3b5a47afacca69a84bf0efad \
    -r 07407000000000000000000000000000 \
    -r 05160000000000000000000000000000 \
    -r 91dba524a6e24909acc48abd7163121a \
    -r 08070000000000000000000000008270 \
    -r 09080000000000000000000000009381 \
    -t 08030000000000000000000000000000 \
    -t 85f630e0f0964c5fa2cc268ce04e3da3 \
    -t 98fb95bcb4bf42d26473eae48690d7ea \
    -t 7b66512021214487ba710a51d7ea78fe \
    -t 09010000000000000000000000000000
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# libteei_daemon_vfs.so reads the RPMB state from
# /mnt/vendor/persist/rpmb/rpmb.txt, and stock has persist mounted when the
# daemon starts. Mount it read-only: the recovery only needs the existing
# state, and nothing here may change the ROM's persist partition.
on fs
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist ro nosuid nodev noatime
    start teei_daemon
