# Microtrust (beanpod) TEE host daemon for the recovery. The arguments are
# those of the stock /vendor/etc/init/microtrust.rc; stock also starts it on
# "fs", before /data exists. The isee-ffa.ko driver it talks to is loaded from
# vendor_ramdisk00. The daemon sets vendor.soter.teei.init=INIT_OK once the
# TEE is up, which starts KeyMint and Gatekeeper.
#
# Like the decryption services of the official OrangeFox trees it runs as root
# in the recovery domain. It starts on "fs", before the recovery mounts any of
# the ROM's partitions, so /vendor still is the ramdisk copy then.

service teei_daemon /vendor/bin/teei_daemon \
    -r 020b0000000000000000000000000000 \
    -r 020f0000000000000000000000000000 \
    -r 06090000000000000000000000000000 \
    -r 05120000000000000000000000000000 \
    -r 40188311faf343488db888ad39496f9a \
    -r 07060000000000000000000000007169 \
    -r 4be4f7dc1f2c11e5b5f7727283247c7f \
    -r 9073f03a9618383bb1856eb3f990babd \
    -r 08050000000000000000000000003419 \
    -r 5020170115e016302017012521300000 \
    -r 0f5eed3c3b5a47afacca69a84bf0efad \
    -r 07407000000000000000000000000000 \
    -r 05160000000000000000000000000000 \
    -r 91dba524a6e24909acc48abd7163121a \
    -r 08070000000000000000000000008270 \
    -r 09080000000000000000000000009381 \
    -t 08030000000000000000000000000000 \
    -t 85f630e0f0964c5fa2cc268ce04e3da3 \
    -t 98fb95bcb4bf42d26473eae48690d7ea \
    -t 7b66512021214487ba710a51d7ea78fe \
    -t 09010000000000000000000000000000
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# TEE device nodes, set like the stock microtrust.rc does before it starts the
# daemon. teei_daemon drops to system after its own setup and only then opens
# the UFS RPMB node. The Gatekeeper TA binds its failure records to RPMB and
# sets RPMB up once, when it loads at INIT_OK; with the node left root 0600 it
# logs "rpmb_open: Failed" and every verify fails with "search uid failed".
on fs
    chmod 0660 /dev/teei_client
    chown system system /dev/teei_client
    chmod 0660 /dev/teei_config
    chown system system /dev/teei_config
    chmod 0666 /dev/isee_tee0
    chown system drmrpc /dev/isee_tee0
    chmod 0660 /dev/tz_vfs
    chown system system /dev/tz_vfs
    chmod 0660 /dev/teei_fp
    chown system /dev/teei_fp
    chown system drmrpc /dev/ut_keymaster
    chmod 0660 /dev/ut_keymaster
    chmod 0660 /dev/0:0:0:49476
    chown system system /dev/0:0:0:49476
    chmod 0660 /dev/rpmb0
    chown system system /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chown root system /dev/mmcblk0rpmb
    chmod 0660 /dev/emmcrpmb0
    chown system system /dev/emmcrpmb0

# Stock also mounts persist at /mnt/vendor/persist, where libteei_daemon_vfs
# keeps the state of a virtual RPMB (rpmb/rpmb.txt). This tablet uses the UFS
# RPMB and its persist/rpmb is empty, so the recovery does not mount it. The
# mount could not work here anyway: first-stage init creates /mnt/vendor before
# SELinux is loaded, so it stays labeled tmpfs, and vendor_init may not create
# directories in it.
on fs
    start teei_daemon
